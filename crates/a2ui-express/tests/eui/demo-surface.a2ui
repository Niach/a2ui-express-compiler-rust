root = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.lg", padding: "$spacing.xl", maxWidth: 560}, children=[demo_card])
demo_card = Card(title="Release 0.18.84", description="Shipped 02:14 · 3 platforms", children=[demo_status, demo_row_errors, demo_row_p95, demo_rollout, demo_chart, demo_actions])
demo_status = Stack(direction="horizontal", gap="sm", align="center", children=[demo_badge, demo_badge_2])
demo_badge = Badge(text="Healthy", variant="default", icon="check")
demo_badge_2 = Badge(text="0 incidents", variant="outline")
demo_row_errors = Row(title="Error rate", value="0.04 %")
demo_row_p95 = Row(title="p95 latency", value="182 ms")
demo_rollout = Progress(value=80, max=100, label="Rollout", tone="primary")
demo_chart = Chart(kind="line", title="Requests per minute", height=140, categories=["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00"], series=[{name: "Requests", values: [420, 380, 510, 640, 590, 610, 700]}])
demo_actions = Stack(direction="horizontal", gap="sm", justify="end", children=[demo_rollback, demo_promote])
demo_rollback = Button(label="Roll back", variant="outline")
demo_promote = Button(label="Promote to 100 %", variant="default")
