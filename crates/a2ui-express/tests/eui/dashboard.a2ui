root = Box(style={display: "flex", flexDirection: "column", gap: "$spacing.lg", padding: "$spacing.lg", width: "100%", backgroundColor: "$color.background", direction: "ltr"}, children=[dash_bar, kpis, dash_tabs, dash_lower, dash_road, dash_footer])
dash_bar = AppBar(title="Agent runs", subtitle=$/team, slots={trailing: dash_actions})
dash_actions = Stack(direction="horizontal", gap="xs", align="center", children=[dash_search, dash_new, dash_menu])
dash_search = Button(icon="search", variant="ghost", size="icon", label="Search", on={press: Event("search")})
dash_new = Button(label="New run", icon="ui-send", size="sm", on={press: Event("newRun")})
dash_menu = Menu(items=[{label: "Export CSV", value: "export", icon: "ui-copy"}, {label: "Archive finished", value: "archive", icon: "ui-archive"}, {label: "Settings", value: "settings", icon: "nav-settings"}], on={select: Event("dashMenu")}, children=[dash_menu_trigger])
dash_menu_trigger = Button(icon="ui-more", variant="ghost", size="icon", label="More")
kpis = Grid(columns={base: 1, md: 3}, gap="md", children=[kpi_1, kpi_2, kpi_3])
kpi_1 = Card(children=[kpi_1_body])
kpi_1_body = Stack(direction="vertical", gap="sm", children=[kpi_1_label, kpi_1_row, kpi_1_spark])
kpi_1_label = Text(text="Runs this week", variant="muted")
kpi_1_row = Stack(direction="horizontal", gap="sm", align="center", justify="between", children=[kpi_1_value, kpi_1_delta])
kpi_1_value = Heading(text="128", level="h2")
kpi_1_delta = Badge(text="+12%", variant="secondary")
kpi_1_spark = Sparkline(values=[8, 12, 9, 15, 14, 21, 18], tone="success", height=32)
kpi_2 = Card(children=[kpi_2_body])
kpi_2_body = Stack(direction="vertical", gap="sm", children=[kpi_2_label, kpi_2_row, kpi_2_spark])
kpi_2_label = Text(text="Median time to merge", variant="muted")
kpi_2_row = Stack(direction="horizontal", gap="sm", align="center", justify="between", children=[kpi_2_value, kpi_2_delta])
kpi_2_value = Heading(text="3h 40m", level="h2")
kpi_2_delta = Badge(text="-18%", variant="secondary")
kpi_2_spark = Sparkline(values=[6, 5.5, 5.8, 4.9, 4.2, 4, 3.7], tone="info", height=32)
kpi_3 = Card(children=[kpi_3_body])
kpi_3_body = Stack(direction="vertical", gap="sm", children=[kpi_3_label, kpi_3_row, kpi_3_progress])
kpi_3_label = Text(text="Monthly budget", variant="muted")
kpi_3_row = Stack(direction="horizontal", gap="sm", align="center", justify="between", children=[kpi_3_value, kpi_3_delta])
kpi_3_value = Heading(text="$412", level="h2")
kpi_3_delta = Badge(text="72%", variant="secondary")
kpi_3_progress = Progress(value=72, max=100, label="Budget used", tone="warning")
dash_tabs = Tabs(tabs=[{label: "Overview", value: "overview", icon: "nav-boards"}, {label: "Runs", value: "runs", count: 4}, {label: "Reviews", value: "reviews", icon: "pr-open"}], value=$/ui/tab, on={change: Event("tab")}, children=[tab_overview, tab_runs, tab_reviews])
tab_overview = Text(text="Throughput, cost and review load across every board.")
tab_runs = Stack(direction="vertical", gap="md", children=[runs_toolbar, runs_table])
runs_toolbar = Stack(direction="horizontal", gap="sm", align="end", wrap=true, children=[runs_search, runs_filter])
runs_search = Input(label="Search runs", name="q", type="search", placeholder="Filter by title or owner", value=$/filter/q, style={flexGrow: 1, flexBasis: 240, minWidth: 0})
runs_filter = Segmented(items=[{label: "All", value: "all"}, {label: "Running", value: "running"}, {label: "In review", value: "review"}, {label: "Merged", value: "merged"}], value=$/filter/state, variant="segmented", on={change: Event("filterState")})
runs_table = Table(columns=[{key: "owner", label: "Owner", type: "slot", slot: "ownerCell", width: 64}, {key: "title", label: "Run", sortable: true}, {key: "state", label: "State", type: "badge"}, {key: "turns", label: "Turns", type: "number", align: "end", sortable: true, width: 72}, {key: "cost", label: "Cost", type: "currency", currency: "USD", decimals: 2, align: "end", width: 88}], rows=$/runs, rowKey="id", selectable="multiple", selected=$/ui/selected, sort={key: "turns", direction: "desc"}, caption="Four runs this week", striped=true, on={sort: Event("sortRuns"), select: Event("selectRuns")}, slots={ownerCell: runs_owner})
runs_owner = Avatar(name=$owner, size="sm")
tab_reviews = Text(text="Open pull requests waiting for a review.")
dash_lower = Grid(columns={base: 1, md: 2}, gap="md", children=[activity_card, reviews_card])
activity_card = Card(title="Activity", padded=false, children=[activity, activity_item])
activity = List(direction="vertical", divided=true, children=[])
activity_item = Row(title=$title, subtitle=$who, meta=$when, icon="ui-issue")
reviews_card = Card(title="Reviews", children=[reviews_range_row, reviews_empty])
reviews_range_row = Stack(direction="vertical", gap="sm", align="start", children=[reviews_range])
reviews_range = Segmented(variant="bar", items=[{label: "Mine", value: "mine"}, {label: "Team", value: "team"}], value="mine")
reviews_empty = EmptyState(icon="pr-open", title="No reviews waiting", description="Pull requests that need you show up here.", actionLabel="Open the queue", on={press: Event("openReviews")})
dash_road = Timeline(source="/road", rowTitle="Workstream", showCount=true)
dash_footer = Stack(direction="horizontal", gap="sm", justify="end", wrap=true, children=[dash_export, invite])
dash_export = Button(label="Export", variant="outline", icon="ui-copy", on={press: Event("export")})
invite = Dialog(title="Invite a member", description="They join the team and see every board.", open=$/ui/inviteOpen, dismissible=true, children=[invite_form], slots={trigger: invite_trigger, footer: invite_send})
invite_form = Form(name="invite", summary=true, on={submit: Event("invite")}, children=[invite_email, invite_role, invite_note])
invite_email = Input(label="Email", name="email", type="email", placeholder="you@example.com", value=$/invite/email, checks=[{condition: email(value=$/invite/email), message: "Enter an email address"}])
invite_role = Select(label="Role", name="role", options=[{label: "Member", value: "member"}, {label: "Owner", value: "owner"}], value=$/invite/role)
invite_note = Textarea(label="Note", name="note", rows=3, placeholder="Optional", value=$/invite/note)
invite_trigger = Button(label="Invite member", icon="ui-assignee")
invite_send = Button(label="Send invite", on={press: Event("sendInvite")})
$/team = "Platform team"
$/ui = {tab: "runs", selected: ["r2"], inviteOpen: false}
$/filter = {q: "", state: "all"}
$/runs = [{id: "r1", owner: "Alex Chen", title: "Fix the flaky sync test on CI", state: "Running", turns: 42, cost: 3.18}, {id: "r2", owner: "Mia Novak", title: "Batch: EXP-874 +2", state: "In review", turns: 117, cost: 9.4}, {id: "r3", owner: "Sam Okafor", title: "Tidy up the Design board", state: "Merged", turns: 8, cost: 0.52}, {id: "r4", owner: "Lena Hart", title: "Add light mode to the conformance matrix", state: "Running", turns: 64, cost: 5.07}]
$/activity = [{id: "a1", title: "Opened PR #812", who: "Mia Novak", when: "2m"}, {id: "a2", title: "Merged the sync fix", who: "Alex Chen", when: "18m"}, {id: "a3", title: "Asked for a review on the dashboard layout", who: "Lena Hart", when: "1h"}]
$/invite = {email: "", role: "member", note: ""}
$/road = {timeline: {scale: "week", columns: [{key: "w0", label: "2 Nov", end: "w0e", today: false}, {key: "w1", label: "9 Nov", end: "w1e", today: true}, {key: "w2", label: "16 Nov", end: "w2e", today: false}, {key: "w3", label: "23 Nov", end: "w3e", today: false}, {key: "w4", label: "30 Nov", end: "w4e", today: false}, {key: "w5", label: "7 Dec", end: "w5e", today: false}, {key: "w6", label: "14 Dec", end: "w6e", today: false}, {key: "w7", label: "21 Dec", end: "w7e", today: false}], bands: [{label: "November", col: 1, span: 5}, {label: "December", col: 6, span: 3}], rows: [{key: "Platform", index: 0, lanes: 2, count: 3, items: [{id: "a", rowIndex: 0, col: 1, span: 3, lane: 0, contL: false, contR: false, tone: 0, row: {title: "Migration"}}, {id: "b", rowIndex: 0, col: 2, span: 2, lane: 1, contL: false, contR: false, tone: 1, row: {title: "Search"}}, {id: "c", rowIndex: 0, col: 6, span: 2, lane: 0, contL: false, contR: false, tone: 2, row: {title: "Billing"}}]}, {key: "Mobile", index: 1, lanes: 1, count: 1, items: [{id: "d", rowIndex: 0, col: 4, span: 1, lane: 0, contL: false, contR: false, tone: 3, row: {title: "Release"}}]}], now: {col: 2, percent: 17.86}}}
